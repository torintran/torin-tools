{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Torin Tools",
  "version": "0.3.1",
  "identifier": "com.torintools.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Torin Tools", "width": 1120, "height": 760, "minWidth": 400 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; worker-src 'self'; connect-src 'self' https://api.github.com ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
